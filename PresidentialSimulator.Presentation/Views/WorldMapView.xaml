<UserControl x:Class="PresidentialSimulator.Presentation.Views.WorldMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#090E18">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="MAPA MUNDIAL"
                           Foreground="#768399"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Situação Geopolítica Global"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>

                <TextBlock Text="Acompanhe países, alianças, crises, eventos e mudanças no equilíbrio mundial."
                           Foreground="#8E9AAF"
                           FontSize="14"
                           Margin="0,8,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="#121C2B"
                    CornerRadius="8"
                    Padding="15,10"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="VISÃO"
                               Foreground="#768399"
                               FontSize="10"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="GLOBAL"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- CONTEÚDO -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>


            <!-- MAPA -->

            <Border Grid.Column="0"
                    Background="#151D2C"
                    CornerRadius="12"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="MAPA GEOPOLÍTICO"
                                       Foreground="#768399"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Mundo"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Background="#182438"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,0,8,0">

                                <TextBlock Text="Relações"
                                           Foreground="#D4DAE5"
                                           FontSize="11"/>

                            </Border>

                            <Border Background="#182438"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,0,8,0">

                                <TextBlock Text="Alianças"
                                           Foreground="#D4DAE5"
                                           FontSize="11"/>

                            </Border>

                            <Border Background="#182438"
                                    CornerRadius="6"
                                    Padding="10,6">

                                <TextBlock Text="Crises"
                                           Foreground="#D4DAE5"
                                           FontSize="11"/>

                            </Border>

                        </StackPanel>

                    </Grid>


                    <Border Grid.Row="2"
                            Background="#0A111D"
                            CornerRadius="10"
                            ClipToBounds="True">

                        <wv2:WebView2 x:Name="MapWebView"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                    </Border>

                </Grid>

            </Border>


            <!-- PAINEL DO PAÍS -->

            <Border Grid.Column="2"
                    Background="#151D2C"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="PAÍS SELECIONADO"
                               Foreground="#768399"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="SelectedCountryTitle"
                               Text="ARGENTINA"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,10,0,5"/>

                    <TextBlock x:Name="SelectedCountrySubtitle"
                               Text="República Argentina"
                               Foreground="#8996A9"
                               FontSize="12"
                               Margin="0,0,0,25"/>


                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Relação com Brasil"
                                   Foreground="#9AA6B8"
                                   FontSize="12"/>

                        <TextBlock x:Name="RelationshipText"
                                   Grid.Column="1"
                                   Text="94/100"
                                   Foreground="#45D483"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                    </Grid>


                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Estabilidade"
                                   Foreground="#9AA6B8"
                                   FontSize="12"/>

                        <TextBlock x:Name="StabilityText"
                                   Grid.Column="1"
                                   Text="82"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                    </Grid>


                    <Grid Margin="0,0,0,25">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Influência"
                                   Foreground="#9AA6B8"
                                   FontSize="12"/>

                        <TextBlock x:Name="InfluenceText"
                                   Grid.Column="1"
                                   Text="76"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                    </Grid>


                    <Separator Background="#273244"
                               Margin="0,0,0,20"/>


                    <TextBlock Text="SITUAÇÃO ATUAL"
                               Foreground="#768399"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="StatusOneText"
                               Text="● União Sul-Americana"
                               Foreground="#D4DAE5"
                               FontSize="13"
                               Margin="0,5"/>

                    <TextBlock x:Name="StatusTwoText"
                               Text="● OTDS"
                               Foreground="#D4DAE5"
                               FontSize="13"
                               Margin="0,5"/>

                    <TextBlock x:Name="StatusThreeText"
                               Text="● Integração econômica"
                               Foreground="#D4DAE5"
                               FontSize="13"
                               Margin="0,5"/>

                    <TextBlock x:Name="StatusFourText"
                               Text="● Estudo federativo em andamento"
                               Foreground="#F4C95D"
                               FontSize="13"
                               Margin="0,5"/>


                    <Border Background="#182438"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,25,0,0">

                        <StackPanel>

                            <TextBlock Text="EVENTO MAIS RECENTE"
                                       Foreground="#768399"
                                       FontSize="10"/>

                            <TextBlock x:Name="RecentEventText"
                                       Text="Audiências públicas nacionais sobre integração federativa."
                                       Foreground="White"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Border>


                    <Button Content="ABRIR DOSSIÊ"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Height="42"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="0,25,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>